{
  "name": "retailops-kiosk",
  "version": "2.2.0",
  "private": true,
  "description": "Native (Capacitor) wrapper for the RetailOps Kiosk PWA. The web app stays static HTML/CSS/ES-modules; this package only builds the iOS/Android shells.",
  "type": "module",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && cap sync",
    "copy": "npm run build:www && cap copy",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/android": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
